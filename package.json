{
  "name": "cafenme-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @cafenme/frontend --filter @cafenme/backend dev:workspace",
    "dev:web": "pnpm --filter @cafenme/frontend dev",
    "dev:api": "pnpm --filter @cafenme/backend start:dev",
    "build": "pnpm --filter @cafenme/frontend build",
    "build:api": "pnpm --filter @cafenme/backend build",
    "start": "pnpm --filter @cafenme/frontend start",
    "typecheck": "pnpm --parallel --filter @cafenme/frontend --filter @cafenme/backend typecheck",
    "typecheck:api": "pnpm --filter @cafenme/backend typecheck",
    "api:generate": "pnpm --filter @cafenme/backend openapi:generate && pnpm exec openapi-typescript backend/openapi.json --output frontend/src/server/api-types.generated.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- backend/openapi.json frontend/src/server/api-types.generated.ts",
    "lint": "biome lint .",
    "check:boundaries": "node frontend/scripts/check-client-boundaries.cjs",
    "react:doctor": "pnpm --filter @cafenme/frontend react:doctor",
    "audit:high": "pnpm audit --audit-level=high",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts,json,css}\"",
    "test": "pnpm --filter @cafenme/frontend test",
    "test:e2e": "pnpm --filter @cafenme/frontend test:e2e",
    "test:watch": "pnpm --filter @cafenme/frontend test:watch",
    "test:int": "pnpm --filter @cafenme/frontend test:int",
    "db:generate": "pnpm --filter @cafenme/backend db:generate",
    "db:migrate": "pnpm --filter @cafenme/backend db:migrate",
    "db:seed": "pnpm --filter @cafenme/backend db:seed",
    "db:seed-menu": "pnpm --filter @cafenme/backend db:seed-menu",
    "db:seed-sales": "pnpm --filter @cafenme/backend db:seed-sales"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "openapi-typescript": "7.12.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "packageManager": "pnpm@11.21.0"
}
