DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# Required; replace with a random secret containing at least 32 characters.
APP_SECRET=
# Optional local override for API request authentication. Production must set this on both apps.
INTERNAL_API_SECRET=
API_PORT=3101
LINE_DEV_MOCK=0

# Account recovery (Resend). Use your verified sending domain.
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=

# Optional contact notifications. Leave empty to store contact messages only.
CONTACT_INBOX_EMAIL=
