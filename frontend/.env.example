# Copy the local values from `pnpm supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nest API base URL. Local development defaults to this URL.
API_BASE_URL=http://127.0.0.1:3101
API_PORT=3101

# 32+ random bytes (e.g. `openssl rand -hex 32`). Signs POS sessions and member QR tokens,
# and derives the key that encrypts LINE channel secrets at rest.
APP_SECRET=

# Optional override for frontend-to-Nest API authentication; must match backend INTERNAL_API_SECRET.
INTERNAL_API_SECRET=

# Local development only: lets /liff pages work without a real LINE login. Ignored in production.
LINE_DEV_MOCK=1
